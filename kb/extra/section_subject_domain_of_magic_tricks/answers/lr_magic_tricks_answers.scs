concept_phrase_magic_prop_unknown
<- sc_node_class;
<= nrel_inclusion: concept_phrase;
=> nrel_main_idtf:
    [фраза о реквизите фокуса: сведений нет] (* <- lang_ru;; *);;

concept_phrase_magic_prop_unknown
-> [Для фокуса ${_magic_prop_unknown_entity_name} в базе знаний не указан реквизит.]
    (* <- lang_ru;; => nrel_phrase_template: @concept_phrase_magic_prop_unknown_template;; *);;

concept_phrase_magic_prop_unknown
-> [В базе знаний пока нет сведений по теме «реквизит» для фокуса ${_magic_prop_unknown_entity_name}.]
    (* <- lang_ru;; => nrel_phrase_template: @concept_phrase_magic_prop_unknown_template;; *);;


