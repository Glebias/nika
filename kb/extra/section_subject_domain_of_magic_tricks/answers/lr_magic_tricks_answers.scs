-> rrel_main_key_sc_element: @lr_answer_magic_prop_unknown_impl;;

..lr_answer_magic_prop_unknown_pattern
<- sc_node_tuple;
-> rrel_1: concept_phrase_magic_prop_unknown;;

atomic_logical_formula
-> @lr_answer_magic_prop_unknown_if;
-> @lr_answer_magic_prop_unknown_then;;

@magic_prop_unknown_entity_name = _[];;
