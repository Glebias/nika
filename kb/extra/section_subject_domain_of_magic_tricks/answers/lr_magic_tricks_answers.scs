// ЛР-03: ответы по фактам о фокусах. Приоритет 1 — факт найден, 3 — сведений нет.


@lr_answer_magic_prop_found_if = [*
    concept_message _-> _message;;
    concept_message_about_magic_prop _-> _message;;
    _message _-> rrel_entity:: _entity;;
    _entity _=> nrel_uses_prop:: _value;;
*];;

@lr_answer_magic_prop_found_then = [*
    _message _=> nrel_reply:: _reply_message;;
    concept_message_about_magic_prop _-> _reply_message;;
    concept_atomic_message _-> _reply_message;;
*];;

@lr_answer_magic_prop_found_impl = (@lr_answer_magic_prop_found_if => nrel_implication: @lr_answer_magic_prop_found_then);;

lr_answer_magic_prop_found
<- concept_answer_on_standard_message_rule;
<- concept_answer_on_standard_message_rule_priority_1;
=> nrel_answer_pattern: ..lr_answer_magic_prop_found_pattern;
-> rrel_main_key_sc_element: @lr_answer_magic_prop_found_impl;;

..lr_answer_magic_prop_found_pattern
<- sc_node_tuple;
-> rrel_1: concept_phrase_magic_prop_found;;

atomic_logical_formula
-> @lr_answer_magic_prop_found_if;
-> @lr_answer_magic_prop_found_then;;

@magic_prop_found_entity_name = _[];;
@magic_prop_found_entity_name => nrel_system_identifier: [_magic_prop_found_entity_name];;

@magic_prop_found_value_name = _[];;
@magic_prop_found_value_name => nrel_system_identifier: [_magic_prop_found_value_name];;


@concept_phrase_magic_prop_found_template = [*
    concept_message _-> _message;;
    _message _-> rrel_entity:: _entity;;
    _entity _=> nrel_magic_ru_name:: @magic_prop_found_entity_name;;
    _entity _=> nrel_uses_prop:: _value;;
    _value _=> nrel_magic_ru_name:: @magic_prop_found_value_name;;
*];;

concept_phrase_magic_prop_found
<- sc_node_class;
<= nrel_inclusion: concept_phrase;
=> nrel_main_idtf:
    [фраза о реквизите фокуса: факт найден] (* <- lang_ru;; *);;

concept_phrase_magic_prop_found
-> [Фокус ${_magic_prop_found_entity_name} использует реквизит ${_magic_prop_found_value_name}.]
    (* <- lang_ru;; => nrel_phrase_template: @concept_phrase_magic_prop_found_template;; *);;

concept_phrase_magic_prop_found
-> [Для фокуса ${_magic_prop_found_entity_name} реквизит — ${_magic_prop_found_value_name}.]
    (* <- lang_ru;; => nrel_phrase_template: @concept_phrase_magic_prop_found_template;; *);;


