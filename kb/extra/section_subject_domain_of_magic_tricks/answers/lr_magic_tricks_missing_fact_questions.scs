// Дополнительные точные вопросы для демонстрации ответа при отсутствии факта.
if_magic_missing_prop = [*
    _message_missing_prop _<- concept_message;;
    _message_missing_prop _<= nrel_sc_text_translation:: .._translation_missing_prop;;
    @magic_missing_prop_link = _[Какой реквизит используется в Летающем столе?];;
    .._translation_missing_prop _-> @magic_missing_prop_link;;
*];;
@magic_missing_prop_link => nrel_system_identifier: [_magic_missing_prop_link];;
then_magic_missing_prop = [*
    concept_message_about_magic_prop _-> _message_missing_prop;;
    _message_missing_prop _-> rrel_entity:: trick_floating_table;;
*];;
lr_classify_magic_missing_prop
<- concept_classify_message_rule_priority_1;
-> rrel_main_key_sc_element: (if_magic_missing_prop => then_magic_missing_prop)
    (* <- nrel_implication;; *);;
atomic_logical_formula -> if_magic_missing_prop; -> then_magic_missing_prop;;
concept_template_with_links -> if_magic_missing_prop;;

