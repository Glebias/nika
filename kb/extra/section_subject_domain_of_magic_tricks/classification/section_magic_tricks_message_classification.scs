section_magic_tricks_message_classification
=> nrel_main_idtf:
    [Раздел. Классификация сообщений предметной области фокусов]
    (* <- lang_ru;; *);
<- atomic_section;;

section_magic_tricks_message_classification = [*
    subject_domain_of_magic_tricks_message_classification
    <- sc_node_struct;
    => nrel_main_idtf:
        [Предметная область классификации сообщений о фокусах]
        (* <- lang_ru;; *);
    <- subject_domain;
    -> rrel_maximum_studied_object_class:
        concept_atomic_message;
    -> rrel_not_maximum_studied_object_class:
        concept_message_about_entity;
        concept_message_about_magic_prop;
        concept_message_about_magic_technique;
        concept_message_about_magic_effect;
    -> rrel_not_maximum_studied_object_class:
        concept_magic_entity_for_wit;;
*];;

section_magic_tricks_message_classification
-> rrel_key_sc_element:
    subject_domain_of_magic_tricks_message_classification;
    concept_message_about_entity;
    concept_message_about_magic_prop;
    concept_message_about_magic_technique;
    concept_message_about_magic_effect;
    concept_magic_entity_for_wit;;
