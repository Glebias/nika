concept_magician
<- sc_node_class;
<= nrel_inclusion: concept_magic_participant;
=> nrel_main_idtf:
    [иллюзионист] (* <- lang_ru;; *);
    [magician] (* <- lang_en;; *);
=> nrel_note:
    [исполнитель, демонстрирующий фокусы зрителям.] (* <- lang_ru;; *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (иллюзионист)] (* <- lang_ru;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (* -> rrel_example:
                [Иллюзионист — исполнитель, демонстрирующий фокусы зрителям.]
                (* <- lang_ru;; *);;
            *);;
    *);;
