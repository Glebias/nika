concept_magic_trick
<- sc_node_class;
<= nrel_inclusion: concept_magic_performance_entity;
=> nrel_main_idtf:
    [фокус] (* <- lang_ru;; *);
    [magic trick] (* <- lang_en;; *);
=> nrel_note:
    [подготовленное исполнительское действие, создающее для зрителя впечатление невозможного события при сокрытом способе выполнения.] (* <- lang_ru;; *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (фокус)] (* <- lang_ru;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (* -> rrel_example:
                [Фокус — подготовленное исполнительское действие, создающее для зрителя впечатление невозможного события при сокрытом способе выполнения.]
                (* <- lang_ru;; *);;
            *);;
    *);;
