=> nrel_note:
    [иллюзионный эффект кажущегося чтения мыслей, предсказания или необычной передачи информации.] (* <- lang_ru;; *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (ментальный эффект)] (* <- lang_ru;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (* -> rrel_example:
                [Ментальный эффект — иллюзионный эффект кажущегося чтения мыслей, предсказания или необычной передачи информации.]
                (* <- lang_ru;; *);;
            *);;
    *);;
