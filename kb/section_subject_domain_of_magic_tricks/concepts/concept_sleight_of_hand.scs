concept_sleight_of_hand
<- sc_node_class;
<= nrel_inclusion: concept_magic_technique;
=> nrel_main_idtf:
    [ловкость рук] (* <- lang_ru;; *);
    [sleight of hand] (* <- lang_en;; *);
=> nrel_note:
    [техника скрытого ручного манипулирования предметом во время фокуса.] (* <- lang_ru;; *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (ловкость рук)] (* <- lang_ru;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (* -> rrel_example:
                [Ловкость рук — техника скрытого ручного манипулирования предметом во время фокуса.]
                (* <- lang_ru;; *);;
            *);;
    *);;
