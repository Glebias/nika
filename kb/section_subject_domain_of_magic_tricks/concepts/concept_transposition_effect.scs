concept_transposition_effect
<- sc_node_class;
<= nrel_inclusion: concept_magic_effect;
=> nrel_main_idtf:
    [эффект перемещения] (* <- lang_ru;; *);
    [transposition effect] (* <- lang_en;; *);
=> nrel_note:
    [иллюзионный эффект, при котором объекты кажутся поменявшимися местами.] (* <- lang_ru;; *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (эффект перемещения)] (* <- lang_ru;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (* -> rrel_example:
                [Эффект перемещения — иллюзионный эффект, при котором объекты кажутся поменявшимися местами.]
                (* <- lang_ru;; *);;
            *);;
    *);;
