concept_card_deck
<- sc_node_class;
<= nrel_inclusion: concept_magic_prop;
=> nrel_main_idtf:
    [колода игральных карт] (* <- lang_ru;; *);
    [deck of playing cards] (* <- lang_en;; *);
=> nrel_note:
    [упорядоченный набор игральных карт, используемый как единый реквизит.] (* <- lang_ru;; *);
