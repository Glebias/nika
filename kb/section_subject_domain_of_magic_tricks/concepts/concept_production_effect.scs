    ...
    (*
        => nrel_main_idtf:
            [Опр. (эффект возникновения множества предметов)] (* <- lang_ru;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (* -> rrel_example:
                [Эффект возникновения множества предметов — эффект последовательного появления нескольких предметов из кажущегося пустым места.]
                (* <- lang_ru;; *);;
            *);;
    *);;
