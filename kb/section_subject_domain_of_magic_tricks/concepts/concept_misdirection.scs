concept_misdirection
<- sc_node_class;
<= nrel_inclusion: concept_magic_technique;
=> nrel_main_idtf:
    [отвлечение внимания] (* <- lang_ru;; *);
    [misdirection] (* <- lang_en;; *);
=> nrel_note:
    [управление вниманием зрителя так, чтобы существенное действие осталось незамеченным.] (* <- lang_ru;; *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (отвлечение внимания)] (* <- lang_ru;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (* -> rrel_example:
                [Отвлечение внимания — управление вниманием зрителя так, чтобы существенное действие осталось незамеченным.]
                (* <- lang_ru;; *);;
            *);;
    *);;
