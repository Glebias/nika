concept_magic_routine
<- sc_node_class;
<= nrel_inclusion: concept_magic_performance_entity;
=> nrel_main_idtf:
    [иллюзионный номер] (* <- lang_ru;; *);
    [magic routine] (* <- lang_en;; *);
=> nrel_note:
    [упорядоченная последовательность связанных фокусов, исполняемая как единое целое.] (* <- lang_ru;; *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (иллюзионный номер)] (* <- lang_ru;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (* -> rrel_example:
                [Иллюзионный номер — упорядоченная последовательность связанных фокусов, исполняемая как единое целое.]
                (* <- lang_ru;; *);;
            *);;
    *);;
