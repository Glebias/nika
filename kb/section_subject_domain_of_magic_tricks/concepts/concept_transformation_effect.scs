concept_transformation_effect
<- sc_node_class;
<= nrel_inclusion: concept_magic_effect;
=> nrel_main_idtf:
    [эффект превращения] (* <- lang_ru;; *);
    [transformation effect] (* <- lang_en;; *);
=> nrel_note:
    [иллюзионный эффект кажущегося изменения свойств или вида объекта.] (* <- lang_ru;; *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (эффект превращения)] (* <- lang_ru;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (* -> rrel_example:
                [Эффект превращения — иллюзионный эффект кажущегося изменения свойств или вида объекта.]
                (* <- lang_ru;; *);;
            *);;
    *);;
