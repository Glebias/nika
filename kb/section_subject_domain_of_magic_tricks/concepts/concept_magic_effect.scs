concept_magic_effect
<- sc_node_class;
<= nrel_inclusion: concept_magic_performance_entity;
=> nrel_main_idtf:
    [иллюзионный эффект] (* <- lang_ru;; *);
    [magic effect] (* <- lang_en;; *);
=> nrel_note:
    [воспринимаемое зрителем кажущееся невозможным событие, составляющее результат фокуса.] (* <- lang_ru;; *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (иллюзионный эффект)] (* <- lang_ru;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (* -> rrel_example:
                [Иллюзионный эффект — воспринимаемое зрителем кажущееся невозможным событие, составляющее результат фокуса.]
                (* <- lang_ru;; *);;
            *);;
    *);;
